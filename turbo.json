{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**"],
      "env": [
        "API_URL",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "DATABASE_URL",
        "NODE_ENV",
        "WXT_API_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["transit", "@repo/vitest-config#build"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "dependsOn": ["db:generate"],
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db:migrate:dev": {
      "dependsOn": ["db:generate"],
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db:migrate:deploy": {
      "dependsOn": ["db:generate"],
      "env": ["DATABASE_URL"],
      "cache": false
    }
  }
}
